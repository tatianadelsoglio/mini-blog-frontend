            },
            {
              "type": "text",
              "id": "UZ8mT",
              "name": "Body",
              "fill": "$color-text-primary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Sí, pero como mejora de fase posterior. Encaja con poemas y lectura nocturna, y los tokens ya están preparados (cada color tiene valor claro/oscuro, mismo nombre). Costo bajo: un toggle en el header + respetar prefers-color-scheme. Fondo marrón casi negro (#1C1A17), no negro puro, para no romper la calidez. Ver fila “Dark” al final del canvas.",
              "lineHeight": 1.6,
              "fontFamily": "$font-body",
              "fontSize": 15,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "Gfy0y",
