              "fontFamily": "$font-heading",
              "fontSize": 24,
              "fontWeight": "600"
            },
            {
              "type": "frame",
              "id": "PVgqH",
              "name": "Code",
              "width": "fill_container",
              "fill": "$color-bg-code",
              "cornerRadius": "$radius-md",
              "layout": "vertical",
              "padding": [
                24,
                28
              ],
              "children": [
                {
                  "type": "text",
                  "id": "cID8T",
                  "name": "Snippet",
                  "fill": "$color-text-code",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "/* Existentes se mantienen; nuevos: */\n@theme inline {\n  --color-bg-code: #2d2926;      --color-text-code: #f5f2e9;\n  --color-border-strong: #8a8378; --color-accent-soft: #e7dfc8;\n  --color-focus: #5c4f2b;        --color-error: #9a3b2e;\n  --font-mono: var(--font-jetbrains-mono);\n  --text-hero-mobile: 2.25rem;   --text-post-title: 2.75rem;  --text-post-title-mobile: 2rem;\n  --text-reading: 1.125rem;      --text-reading--line-height: 1.75;\n  --text-poem: 1.3125rem;        --text-poem--line-height: 1.9;\n  --text-label: 0.875rem;        --text-code: 0.9375rem;\n  --spacing-2xs: 4px; --spacing-xs: 8px; --spacing-sm: 12px; --spacing-md: 16px; --spacing-lg: 24px;\n  --spacing-xl: 32px; --spacing-2xl: 40px; --spacing-3xl: 48px; --spacing-4xl: 64px; --spacing-5xl: 80px; --spacing-6xl: 120px;\n  --spacing-touch: 44px;\n  --radius-full: 9999px;\n  --max-width-poem: 32.5rem;     --max-width-content: 82rem;\n}\n/* Modo oscuro: mover colores a variables en :root y [data-theme=\"dark\"],\n   y en @theme inline referenciarlas: --color-bg: var(--bg); */",
                  "lineHeight": 1.6,
                  "fontFamily": "$font-mono",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "Fg1cw",
          "name": "Índice",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 8,
