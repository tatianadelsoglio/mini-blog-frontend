# URL base de Strapi. Solo la usa el servidor (build, ISR y route handlers).
STRAPI_URL=http://localhost:1337

# URL pública del bucket de Supabase Storage (incluye el nombre del bucket).
# Es la misma que SUPABASE_PUBLIC_URL del backend. Habilita next/image para esas imágenes.
SUPABASE_PUBLIC_URL=https://tu-project-ref.supabase.co/storage/v1/object/public/uploads

# Secreto del webhook de Strapi -> /api/revalidate (header x-revalidate-secret).
REVALIDATE_SECRET=cambiar-por-un-secreto-largo

# URL pública del sitio (canonical, sitemap, Open Graph). En Vercel, si falta,
# se usa el dominio de producción del proyecto.
SITE_URL=http://localhost:3000
